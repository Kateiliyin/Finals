def press(key, text):
    while True:
        ans = input(text)
        if ans.lower() == key:
            print("")
            break
        else:
            print("Press " + key.upper() + ". Try again.")

def press_enter(text):
    while True:
        ans = input(text)
        if ans == "":
            print("")
            break
        else:
            print("Invalid. Press Enter. Try again.")
            

